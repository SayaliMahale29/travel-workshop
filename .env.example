# Copy this file to .env.local and fill in your values

# Site URL (use your domain after go-live, e.g. https://workshop.akasheyess.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin login (change these!)
ADMIN_PASSWORD=change-this-strong-password

# Razorpay — get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Email (Resend — free tier at https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Workshop <onboarding@resend.dev>
ORGANIZER_EMAIL=your-email@gmail.com

# WhatsApp Business API (Interakt — https://app.interakt.ai)
# Leave empty until account is ready; emails will still work
WHATSAPP_API_URL=https://api.interakt.ai/v1/public/message/
WHATSAPP_API_KEY=
WHATSAPP_TEMPLATE_NAME=workshop_confirmation
